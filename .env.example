# Copy to .env and fill in for your machine:  cp .env.example .env
# Real environment variables override these values.

# --- Database -------------------------------------------------------------
# PGPASSWORD = robot_writer role (used by the loggers and the scripts).
# GRAFANA_PASSWORD = grafana_ro role (used by db_init.sh and the Grafana datasource).
PGPASSWORD=change_me_writer
GRAFANA_PASSWORD=change_me_grafana
DB_CONNINFO=host=localhost port=5432 dbname=robot_data user=robot_writer

# --- Robot telemetry multicast -------------------------------------------
# On a multi-homed host, set this to the IP of the NIC on the robot's network.
ROBOT_MCAST_IFACE=0.0.0.0
# ROBOT_MCAST_GROUP=239.0.0.1
# ROBOT_MCAST_PORT=10001

# --- SSL-Vision multicast (defaults shown) -------------------------------
# VISION_MCAST_GROUP=224.5.23.2
# VISION_MCAST_PORT=10006
# VISION_MCAST_IFACE=0.0.0.0

# --- Batching (optional) --------------------------------------------------
# DB_BATCH_SIZE=50
# DB_MAX_LATENCY_MS=200

# --- drone_logger (DJI Mini 3 Pro live video, dji-relay) --------------------
# RTP/H.264 from the phone app, unicast (dji-relay docs/protocol.md).
# DRONE_VIDEO_PORT=5600
# JSON messages (telemetry, events, frame metadata, clock beacons), dji-relay docs/protocol.md.
# DRONE_MSG_PORT=5601
# DRONE_BIND_ADDR=0.0.0.0
# Per-session folder: <DRONE_OUTPUT_DIR>/<UTC start>/ with video_live_NN.mkv
# (plus the CSV files below if enabled, and rtp_packets.csv if DRONE_PACKET_LOG=1).
# DRONE_OUTPUT_DIR=drone_sessions
# Rows go to the drone.* tables (sql/04_drone.sql) through DB_CONNINFO above.
# DRONE_DB=1
# Also write live_frames.csv / injected_frames.csv in the session folder (bench tests without a database).
# DRONE_CSV=0
# How long an access unit waits for its injection time before its drone.live_frame row is written.
# DRONE_INJECT_WAIT_MS=1500
# Configuration check (drone.config_check): accepted values, one or a comma-separated list;
# unset = not checked. Live stream measured in F2: 1440x1080, 30 fps, H264.
# DRONE_EXPECT_WIDTH=1440
# DRONE_EXPECT_HEIGHT=1080
# DRONE_EXPECT_FPS=30
# DRONE_EXPECT_MIME=H264
# Jitter buffer latency (ms): smooths Wi-Fi jitter, adds the same amount of latency.
# DRONE_JITTER_LATENCY_MS=50
# Decoder: nvh264dec (NVIDIA), falls back to avdec_h264 if it is not available.
# DRONE_DECODER=nvh264dec
# DRONE_RECORD=1
# Injection into SSL-Vision through v4l2loopback (video_nr=10 card_label="DJI drone" exclusive_caps=1).
# DRONE_INJECT=1
# DRONE_V4L2_DEVICE=/dev/video10
# DRONE_SHOW_VIDEO=0
# DRONE_PACKET_LOG=0
# A stream with no packets for this long is closed (its .mkv finalised); the next packet starts a new one.
# DRONE_STREAM_TIMEOUT_MS=2000
